{
  "name": "casbin",
  "version": "5.43.0",
  "description": "An authorization library that supports access control models like ACL, RBAC, ABAC in Node.JS",
  "main": "lib/cjs/index.js",
  "typings": "lib/cjs/index.d.ts",
  "module": "lib/esm/index.mjs",
  "exports": {
    ".": {
      "types": "./lib/cjs/index.d.ts",
      "import": "./lib/esm/index.mjs",
      "require": "./lib/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "run-s lint test build",
    "postpack": "run-s clean",
    "build": "run-s clean && run-p build:*",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsup src/index.ts --format esm --outDir lib/esm --no-splitting --no-dts",
    "test": "jest",
    "lint": "eslint . --ext .js,.ts",
    "fmt": "eslint . --ext .js,.ts --fix",
    "commit": "git-cz",
    "clean": "rimraf lib",
    "coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^26.0.20",
    "@types/node": "^10.5.3",
    "@types/picomatch": "^2.2.2",
    "@typescript-eslint/eslint-plugin": "^4.17.0",
    "@typescript-eslint/parser": "^4.17.0",
    "cz-conventional-changelog": "^3.2.0",
    "eslint": "^7.22.0",
    "eslint-config-prettier": "^6.12.0",
    "eslint-plugin-prettier": "^3.3.1",
    "husky": "^2.3.0",
    "jest": "^26.6.3",
    "lint-staged": "^8.1.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.2.1",
    "pretty-quick": "^3.1.0",
    "rimraf": "^3.0.2",
    "ts-jest": "^26.5.3",
    "tslint": "^5.11.0",
    "tsup": "^8.5.1",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@casbin/expression-eval": "^5.3.0",
    "await-lock": "^2.0.1",
    "buffer": "^6.0.3",
    "csv-parse": "^5.5.6",
    "minimatch": "^10.2.1"
  },
  "files": [
    "lib",
    "examples"
  ],
  "homepage": "https://casbin.apache.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/apache/casbin-node-casbin.git"
  },
  "license": "Apache-2.0",
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && git cz --hook || true",
      "pre-commit": "yarn fmt && pretty-quick --staged"
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
